# ─────────────────────────────────────────────────────────────
# 스마트워크 랩 (SmartWork Lab) 환경 변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#
# ⚠️ 환경 변수를 설정하지 않아도 앱은 "데모 모드"로 즉시 실행됩니다.
#    (내장 시드 데이터로 모든 화면을 확인할 수 있습니다.)
#    실제 운영에서는 아래 값을 반드시 설정하세요.
# ─────────────────────────────────────────────────────────────

# Supabase — 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (관리자 작업 / 시드) — 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — AI 운영 분석 기능
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 조직 도메인 제한 (Google 로그인 허용 도메인, 비우면 제한 없음)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=uman.or.kr
